# Instagram Graph API (official)
# Create a Facebook App, connect an Instagram Business or Creator account, and get a long-lived access token.
# Set the following in your local environment (do NOT commit real tokens to git):

INSTAGRAM_USE_GRAPH=1
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here
INSTAGRAM_COUNT=6